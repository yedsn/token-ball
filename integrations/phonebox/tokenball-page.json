iods.forEach(function(pair){var window=(account.periods||{})[pair[0]],cell=el('div','period');cell.appendChild(el('div','period-label',pair[1]));\n        cell.appendChild(ring(window&&window.remainingPercent,false));\n        var countdownNode=el('div','reset'),dateNode=el('div','reset',date(window&&window.resetAt));\n        cell.appendChild(countdownNode);cell.appendChild(dateNode);grid.appendChild(cell);\n        updates.push(function(time){var color=timeClass(window&&window.resetAt,pair[0],time);countdownNode.className='reset '+color;dateNode.className='reset '+color;countdownNode.textContent=countdown(window&&window.resetAt,time);});});\n      article.appendChild(grid);\n      var foot=el('div','foot'), collectionColor=collected===null?'unknown':cached||now-collected>3600000?'critical':'healthy';\n      footTime(foot,'实际采集',account.collectedAt,collectionColor);\n      footTime(foot,'订阅到期',account.subscriptionUntil,timeClass(account.subscriptionUntil,null,now));\n      article.appendChild(foot);\n      var cover=el('div','account-cover '+(providers[account.provider]?account.provider:''));cover.setAttribute('aria-hidden','true');\n      var image=accountImages[account.id];\n      if(typeof image==='string'&&/^data:image\\/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$/.test(image)){var picture=el('img');picture.src=image;picture.alt='';cover.appendChild(picture);}\n      article.appendChild(cover);list.appendChild(article);\n      var dot=el('button','page-dot');dot.type='button';dot.setAttribute('aria-label','查看'+accountName(account));dot.addEventListener('click',function(){go(index,true);});pagination.appendChild(dot);\n      updates.push(function(time){\n        var cachedNow=!!account.stale||account.connectionStatus!=='healthy'||collected===null||collected>time+300000||until===null||until<=time;\n        var state=statusClass(account,cachedNow),label=statuses[account.status]||'未知';\n        badge.className='status '+state;badge.textContent=cachedNow?(state==='criti
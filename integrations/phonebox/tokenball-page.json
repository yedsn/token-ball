            "html": "<style>\n:root{--mint:#a9edcb;--green:#19c37d;--muted:#8fa19b;--line:#ffffff12;--amber:#e9b949;--red:#ff5a54;--panel:#14231e;--surface:#101b17}\n*{box-sizing:border-box}\nbody{font-family:\"Segoe UI\",\"Microsoft YaHei\",sans-serif;background:#0c1612;color:#f0f7f2;margin:0}\nmain{height:100vh;display:grid;grid-template-columns:minmax(220px,30%) minmax(0,1fr);grid-template-rows:minmax(0,1fr);padding:14px;gap:14px;overflow:hidden}\n.overview{min-width:0;min-height:0;height:100%;display:flex;flex-direction:column;padding:24px 20px;background:var(--panel);border:1px solid var(--line);border-radius:24px;overflow:auto}\n.top{display:flex;flex-direction:column;gap:14px;align-items:flex-start;flex-shrink:0}\n.eyebrow{font-size:9px;letter-spacing:.2em;color:var(--mint)}\nh1{font-size:17px;font-weight:600;margin:5px 0 0;letter-spacing:.04em}\n.badge{font-size:10px;white-space:nowrap;color:var(--mint);border:1px solid #a9edcb20;background:#a9edcb08;padding:6px 9px;border-radius:20px}\n.metrics{display:flex;flex:1;flex-direction:column;align-items:center;justify-content:center;gap:26px;padding:24px 0}\n.ring{--ring-color:var(--mint);--ring-size:82px;--ring-width:5px;position:relative;isolation:isolate;width:var(--ring-size);height:var(--ring-size);flex-shrink:0;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:conic-gradient(var(--ring-color) var(--sweep),#ffffff0d 0)}\n.ring:before{content:\"\";position:absolute;inset:var(--ring-width);border-radius:50%;background:var(--surface);z-index:-1}\n.ring.unknown{background:none;border:2px dashed #8faaa138;color:var(--muted)}\n.ring.unknown:before{inset:0}\n.ring.healthy{--ring-color:var(--green)}.ring.warning{--ring-color:var(--amber)}.ring.critical{--ring-color:var(--red)}\n.percent{font-family:\"Bahnschrift\",\"DIN Alternate\",Consolas,monospace;font-size:23px;font-weight:600;line-height:1;letter-spacing:-.05em;font-variant-numeric:tabular-nums}\n.hero-ring{--ring-size:164px;--ring-width:7px}\n.hero-ring:before{background:var(--panel)}\n.hero-ring .percent{font-size:53px;letter-spacing:-.07em}\n.ring-caption{font-size:11px;color:var(--muted);margin-top:9px;letter-spacing:.06em}\n.summary-details{display:grid;grid-template-columns:1fr 1fr;gap:18px 12px;min-width:0;width:100%;text-align:center}\n.metric{font-size:10px;color:var(--muted);line-height:1.5}\n.metric b{display:block;font-family:\"Bahnschrift\",Consolas,monospace;font-size:25px;font-weight:500;color:#f0f7f2;line-height:1.15;margin-bottom:3px;font-variant-numeric:tabular-nums}\n.summary-note{grid-column:1/-1;font-size:9px;color:var(--muted);margin:0;line-height:1.6}\n.notice{font-size:10px;color:var(--amber);margin:0;line-height:1.5;flex-shrink:0}.notice:empty{display:none}\n.carousel{min-width:0;min-height:0;display:flex;flex-direction:column;gap:12px}\n.carousel-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:5px 4px;flex-shrink:0}\n.carousel-title{font-size:14px;font-weight:600}.carousel-caption{font-size:9px;color:var(--muted);margin-top:4px;letter-spacing:.08em}\n.carousel-controls{display:flex;align-items:center;gap:10px}.counter{font-family:Consolas,monospace;color:var(--muted);font-size:12px;white-space:nowrap}\nbutton{font:inherit;cursor:pointer;color:var(--mint);background:#a9edcb0a;border:1px solid #a9edcb24}\n.arrow{width:34px;height:34px;border-radius:50%;font-size:22px;line-height:1}\nbutton:disabled{opacity:.3;cursor:default}button:focus-visible{outline:2px solid var(--mint);outline-offset:3px}\n.accounts{flex:1;min-height:0;display:flex;gap:12px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain;border-radius:22px}\n.accounts::-webkit-scrollbar{display:none}\n.account{flex:0 0 100%;min-width:0;min-height:0;display:flex;flex-direction:column;gap:0;padding:0;background:var(--surface);border:1px solid var(--line);border-radius:22px;overflow-y:auto;scroll-snap-align:start;scroll-snap-stop:always;scrollbar-width:thin;scrollbar-color:#355045 transparent}\n.account-head,.foot{margin-left:22px;margin-right:22px}\n.account-head{margin-top:18px}\n.account-cover{order:-1;position:relative;isolation:isolate;flex-shrink:0;height:clamp(48px,14vh,120px);overflow:hidden;background:radial-gradient(ellipse at 70% 130%,#c1dfb061,transparent 54%),linear-gradient(125deg,#243d35,#0c211c 55%,#4d7152);border-bottom:1px solid var(--line)}\n.account-cover:before{content:\"\";position:absolute;width:180px;height:180px;left:15%;top:20%;border:1px solid #c9e8c54a;border-radius:50%;box-shadow:0 0 0 26px #c9e8c50a,0 0 0 52px #c9e8c508;transform:rotate(-25deg) scaleX(1.8)}\n.account-cover:after{content:\"\";position:absolute;inset:0;background:linear-gradient(165deg,transparent 40%,#06171099);z-index:-1}\n.account-cover.volcengine{background:radial-gradient(ellipse at 60% 140%,#d3985e70,transparent 60%),linear-gradient(125deg,#392b25,#171f1c 55%,#805b3d)}\n.account-cover.qianwen{background:radial-gradient(ellipse at 80% 0%,#7389ac66,transparent 65%),linear-gradient(135deg,#18252f,#122322 60%,#304f54)}\n.account-cover img{position:relative;z-index:1;width:100%;height:100%;object-fit:cover;display:block}\n.pagination{display:flex;gap:6px;justify-content:center;align-items:center;overflow-x:auto;min-height:24px;flex-shrink:0;padding:4px}\n.page-dot{width:8px;height:8px;flex-shrink:0;border:0;border-radius:50%;padding:0;background:#8fa19b45;transition:width .18s,background .18s}\n.page-dot.active{width:24px;border-radius:5px;background:var(--mint)}\n.account-head{display:flex;justify-content:space-between;align-items:start;gap:12px;flex-shrink:0}.account-head>div{min-width:0}.name{font-size:16px;font-weight:600;letter-spacing:.02em;overflow-wrap:anywhere}\n.meta,.foot{color:var(--muted);font-size:9px;line-height:1.7;overflow-wrap:anywhere}.meta{margin-top:3px}\n.periods{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:24px 22px;flex-shrink:0}\n.period{min-width:0;text-align:center;display:flex;flex-direction:column;align-items:center}\n.period-label{font-size:11px;color:var(--muted);margin-bottom:12px}.period .ring{--ring-size:clamp(76px,11vw,140px);margin-bottom:14px}.period .percent{font-size:clamp(25px,3.2vw,40px)}\n.reset{font-size:11px;color:var(--muted);line-height:1.8;overflow-wrap:anywhere}\n.foot{border-top:1px solid var(--line);padding:12px 0 18px;display:flex;flex-wrap:wrap;gap:3px 12px;margin-top:auto;flex-shrink:0}\n.foot-label{color:var(--muted);margin-right:4px}.foot time{font-weight:500}\n.healthy{color:var(--green)}.warning{color:var(--amber)}.critical{color:var(--red)}.unknown{color:var(--muted)}\n.badge.healthy,.status.healthy{border-color:#19c37d40;background:#19c37d0c}.badge.warning,.status.warning{border-color:#e9b94940;background:#e9b9490c}.badge.critical,.status.critical{border-color:#ff5a5440;background:#ff5a540c}.badge.unknown{border-color:var(--line);background:transparent}\n.empty{padding:24px 8px;color:var(--muted);font-size:12px;line-height:1.8}.status{font-size:10px;white-space:normal;max-width:40%;text-align:right;flex-shrink:0;padding:4px 8px;border:1px solid var(--line);border-radius:20px}\n@media(max-width:599px){main{grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr);padding:10px;gap:12px}.overview{padding:16px}.top{flex-direction:row;justify-content:space-between;align-items:center;gap:8px}.metrics{flex-direction:row;padding:16px 0 0;gap:20px}.hero-ring{--ring-size:134px}.hero-ring .percent{font-size:44px}.summary-details{width:auto;flex:1;grid-template-columns:1fr;text-align:left;gap:10px}.summary-note{font-size:8px}.notice{margin-top:10px}.account-cover{height:clamp(60px,13vh,110px)}.account-head,.periods,.foot{margin-left:16px;margin-right:16px}}\n@media(max-width:599px){.periods{margin-top:18px;margin-bottom:18px;gap:8px}.period .ring{--ring-size:clamp(66px,19vw,100px)}.period .percent{font-size:clamp(21px,6vw,30px)}.reset{font-size:10px}.name{font-size:14px}.overview{height:auto}}\n@media(max-width:360px){main{padding:8px;gap:8px}.overview{padding:12px}.hero-ring{--ring-size:114px}.hero-ring .percent{font-size:39px}.metrics{gap:16px;padding-top:12px}.periods{gap:6px}.period .ring{--ring-size:66px}.period .percent{font-size:20px}.metric b{font-size:22px}.account-head,.periods,.foot{margin-left:12px;margin-right:12px}.carousel-toolbar{padding:0 4px}.arrow{width:34px;height:34px}}\n@media(min-width:600px) and (max-height:400px){main{padding:10px;gap:12px}.overview{padding:16px}.top{gap:10px}.metrics{padding:14px 0;gap:14px}.hero-ring{--ring-size:108px;--ring-width:5px}.hero-ring .percent{font-size:36px}.ring-caption{font-size:9px;margin-top:7px}.metric b{font-size:21px}.summary-details{gap:10px}.notice{font-size:9px}.account-cover{height:65px}.periods{margin-top:12px;margin-bottom:10px}.period .ring{--ring-size:66px}.period .percent{font-size:20px}}\n@media(prefers-reduced-motion:reduce){.page-dot{transition:none}}\n@media(min-width:600px) and (max-height:520px){.overview{padding:18px 16px}.top{flex-direction:row;align-items:center;justify-content:space-between;gap:8px}.top .eyebrow{display:none}.top h1{margin:0;font-size:15px}.badge{font-size:9px}.metrics{gap:16px;padding:14px 0;flex-shrink:0}.hero-ring{--ring-size:134px}.hero-ring .percent{font-size:44px}.summary-details{gap:12px}.metric b{font-size:23px}.account-cover{height:44px}.account-head{margin-top:14px}.periods{margin-top:14px;margin-bottom:12px}.period .ring{--ring-size:78px;margin-bottom:10px}.period .percent{font-size:26px}.period-label{margin-bottom:8px}.reset{font-size:10px}.foot{padding-top:10px;padding-bottom:12px}}\n@media(min-width:600px) and (max-height:400px){.overview{padding:12px}.top{flex-direction:row;align-items:center;justify-content:space-between;gap:6px}.eyebrow{display:none}h1{font-size:14px;margin:0}.badge{font-size:8px;padding:5px 7px}.metrics{padding:10px 0;gap:10px}.hero-ring{--ring-size:96px}.hero-ring .percent{font-size:33px}.summary-details{gap:8px}.summary-note{font-size:8px}.metric{font-size:9px}}\n@media(min-width:600px) and (max-height:520px){.account-cover{height:30px}.account-head{margin-top:10px}.periods{margin-top:10px;margin-bottom:10px}.period .ring{margin-bottom:8px}.reset{line-height:1.6}.foot{padding-top:8px;padding-bottom:8px}}\n</style>\n<main>\n  <aside class=\"overview\" aria-label=\"额度总览\">\n    <header class=\"top\"><div><div class=\"eyebrow\">TOKENBALL / QUOTA MONITOR</div><h1>额度总览</h1></div><span id=\"connection\" class=\"badge\">等待推送</span></header>\n    <section id=\"metrics\" class=\"metrics\" aria-label=\"额度汇总\"></section>\n    <p id=\"notice\" class=\"notice\" role=\"status\"></p>\n  </aside>\n  <section class=\"carousel\" aria-label=\"账号额度轮播\">\n    <header class=\"carousel-toolbar\"><div><div class=\"carousel-title\">账号额度</div><div class=\"carousel-caption\">ACCOUNT COLLECTION</div></div><nav class=\"carousel-controls\" aria-label=\"切换账号\"><span id=\"counter\" class=\"counter\" aria-live=\"polite\">0 / 0</span><button id=\"previous\" class=\"arrow\" type=\"button\" aria-label=\"上一个账号\">‹</button><button id=\"next\" class=\"arrow\" type=\"button\" aria-label=\"下一个账号\">›</button></nav></header>\n    <section id=\"accounts\" class=\"accounts\" aria-label=\"账号卡片\" tabindex=\"0\"></section>\n    <nav id=\"pagination\" class=\"pagination\" aria-label=\"选择账号\"></nav>\n  </section>\n</main>\n<script>\n(function () {\n  'use strict';\n  var current = null;\n  // Optional embedded pictures, keyed by the opaque account ID from the push payload.\n  // Only base64 PNG/JPEG/WebP data URLs are accepted; no remote requests.\n  var accountImages = {};\n  var accountIds = [], selectedId = null, selectedIndex = 0, signature = null, updates = [];\n  var periods = [['fiveHour', '5 小时'], ['weekly', '每周'], ['monthly', '每月']];\n  var providers = {cliProxyApi:'CLIProxyAPI',volcengine:'火山引擎',qianwen:'千问'};\n  var statuses = {available:'可用',warning:'预警',cooldown:'冷却中',exhausted:'已耗尽',disabled:'停用',authExpired:'登录失效',offline:'离线',error:'异常',unknown:'未知'};\n  function el(tag, cls, value) { var node=document.createElement(tag); if(cls)node.className=cls; if(value!==undefined)node.textContent=String(value); return node; }\n  function clear(node) { while(node.firstChild)node.removeChild(node.firstChild); }\n  var listNode=document.getElementById('accounts'), pagination=document.getElementById('pagination');\n  function navigation() {\n    document.getElementById('counter').textContent=accountIds.length?(selectedIndex+1)+' / '+accountIds.length:'0 / 0';\n    document.getElementById('previous').disabled=accountIds.length<2;\n    document.getElementById('next').disabled=accountIds.length<2;\n    Array.prototype.forEach.call(pagination.children,function(dot,index){dot.className='page-dot'+(index===selectedIndex?' active':'');dot.setAttribute('aria-current',index===selectedIndex?'true':'false');});\n  }\n  function go(index, animate) {\n    if(!accountIds.length)return;\n    selectedIndex=(index+accountIds.length)%accountIds.length;selectedId=accountIds[selectedIndex];\n    var reduced=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    listNode.scrollTo({left:selectedIndex*(listNode.clientWidth+12),behavior:animate&&!reduced?'smooth':'instant'});navigation();\n  }\n  document.getElementById('previous').addEventListener('click',function(){go(selectedIndex-1,true);});\n  document.getElementById('next').addEventListener('click',function(){go(selectedIndex+1,true);});\n  listNode.addEventListener('scroll',function(){var index=Math.round(listNode.scrollLeft/(listNode.clientWidth+12));if(index>=0&&index<accountIds.length){selectedIndex=index;selectedId=accountIds[index];navigation();}});\n  listNode.addEventListener('keydown',function(event){if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();go(selectedIndex+(event.key==='ArrowRight'?1:-1),true);}});\n  window.addEventListener('resize',function(){go(selectedIndex);});\n  function resetCards() {clear(listNode);clear(pagination);accountIds=[];signature=null;updates=[];navigation();}\n  function number(value) { return typeof value==='number' && isFinite(value); }\n  function fmt(value, suffix) { return number(value) ? String(Math.round(value*10)/10)+(suffix||'') : '--'; }\n  function timestamp(value) { if(!value)return null; var t=Date.parse(value); return isFinite(t)&&t>0?t:null; }\n  function date(value) { var t=timestamp(value); return t===null?'--':new Date(t).toLocaleString(); }\n  function accountName(account) { return account.displayName||account.alias||'账号'; }\n  function trayOrder(left,right) {\n    function compareTime(a,b) {return a===b?0:a===null?1:b===null?-1:a-b;}\n    function priority(account) {\n      if(Object.prototype.hasOwnProperty.call(account,'priorityResetAt'))return timestamp(account.priorityResetAt);\n      // Older senders have no priority hint; use only their available periods.\n      var windows=account.periods||{};\n      for(var i=2;i>=0;i--){var time=timestamp(windows[periods[i][0]]&&windows[periods[i][0]].resetAt);if(time!==null)return time;}\n      return null;\n    }\n    return compareTime(timestamp(left.subscriptionUntil),timestamp(right.subscriptionUntil))\n      ||compareTime(priority(left),priority(right))\n      ||accountName(left).localeCompare(accountName(right),'zh-CN');\n  }\n  function countdown(value, now) { var t=timestamp(value); if(t===null)return '--'; var seconds=Math.ceil((t-now)/1000); if(seconds<=0)return '等待额度刷新'; var days=Math.floor(seconds/86400),hours=Math.floor(seconds%86400/3600),minutes=Math.floor(seconds%3600/60); return (days?days+'天 ':'')+(hours?hours+'小时 ':'')+minutes+'分钟后恢复'; }\n  function metric(root, label, value) { var node=el('div','metric');node.appendChild(el('b','',value));node.appendChild(el('span','',label));root.appendChild(node); }\n  function quotaClass(value) { return !number(value)||value<0||value>100?'unknown':value<30?'critical':value<60?'warning':'healthy'; }\n  function timeClass(value, period, now) {\n    var time=timestamp(value);if(time===null)return 'unknown';\n    var hours=(time-now)/3600000, limits={fiveHour:[1,3],weekly:[24,72],monthly:[72,168]}[period]||[72,168];\n    return hours<=limits[0]?'critical':hours<=limits[1]?'warning':'healthy';\n  }\n  function statusClass(account, cached) {\n    if(['authExpired','offline','error','exhausted'].indexOf(account.status)>=0)return 'critical';\n    if(cached||['warning','cooldown'].indexOf(account.status)>=0)return 'warning';\n    return account.status==='available'?'healthy':'unknown';\n  }\n  function footTime(root, label, value, color) {\n    var part=el('span');part.appendChild(el('span','foot-label',label));part.appendChild(el('time',color,date(value)));root.appendChild(part);\n  }\n  function ring(value, hero) {\n    var known=number(value)&&value>=0&&value<=100;\n    var node=el('div','ring'+(hero?' hero-ring':'')+' '+quotaClass(known&&!hero?Math.round(value):value));\n    if(known)node.style.setProperty('--sweep',(value*3.6)+'deg');\n    node.appendChild(el('b','percent',known?fmt(value,'%'):'--'));\n    if(hero)node.appendChild(el('span','ring-caption','总体余量'));\n    return node;\n  }\n  function render() {\n    var now=Date.now(), connection=document.getElementById('connection'), metrics=document.getElementById('metrics'), notice=document.getElementById('notice'), list=document.getElementById('accounts');\n    clear(metrics);notice.textContent='';connection.className='badge unknown';\n    if(!current || (number(current.expiresAt)&&current.expiresAt<=now)) { resetCards();connection.textContent='等待推送';list.appendChild(el('div','empty','未收到数据。请在 TokenBall 保存并启用 PhoneBox 推送。'));return; }\n    var data=current.data;\n    if(!data || data.schema!=='tokenball.phonebox.v1') {resetCards();connection.textContent='版本不兼容';connection.className='badge critical';list.appendChild(el('div','empty','请更新 TokenBall